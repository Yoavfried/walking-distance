{
  "name": "walking-distance",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "routes": [],
  "vars": {
    "BASE_PATH": "/walking-distance",
    "PUBLIC_ORIGIN": "https://yoavfried.com"
  },
  "assets": {
    "directory": "./dist-public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/walking-distance", "/walking-distance/", "/walking-distance/api/*"]
  },
  "ratelimits": [
    { "name": "VISITOR_LIMIT", "namespace_id": "48211", "simple": { "limit": 6, "period": 60 } },
    { "name": "DEMO_LIMIT", "namespace_id": "48212", "simple": { "limit": 20, "period": 60 } }
  ]
}
